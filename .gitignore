# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
/.omc/
/.omx/
.impeccable


# ide
/.idea/
/.playwright-cli/
/output/playwright/
/test-results/

# Reproducible product capture runtime (generated locally and in CI).
/.product-captures-cache/
/.github/actions/product-captures/node_modules/
# Standalone capture tool is checked by product-captures-check.yml.
/docs/assets/product-captures/gallery.html
/docs/assets/product-captures/manifest.json
/public/projects/web-portfolio-v2/gallery.html
/public/projects/web-portfolio-v2/manifest.json
