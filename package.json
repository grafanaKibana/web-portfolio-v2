{
  "name": "web-portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"app/**/*.{css,scss}\" --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:content": "NODE_OPTIONS=--conditions=react-server tsx --test tests/content.test.ts",
    "test:contrast": "tsx --test tests/contrast.test.ts",
    "test:documentation": "tsx --test tests/documentation.test.ts",
    "test:seo": "NODE_OPTIONS=--conditions=react-server tsx --test tests/seo.test.ts",
    "setup:browsers": "playwright install chromium webkit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.1",
    "@thesvg/react": "^3.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0"
  }
}
