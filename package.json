{
  "name": "web-portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:hero-backgrounds": "node --import tsx scripts/generate-hero-backgrounds.mjs",
    "predev": "npm run generate:hero-backgrounds",
    "prebuild": "npm run generate:hero-backgrounds",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"{app,components}/**/*.{css,scss}\" \"mdx-components.module.scss\" --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit:client": "node --import tsx --test \"{app,components,lib,scripts,tests}/**/!(*.server).test.{ts,tsx,mjs}\"",
    "test:unit:server": "node --conditions=react-server --import tsx --test \"{app,components,lib,scripts,tests}/**/*.server.test.{ts,tsx,mjs}\"",
    "test:unit": "npm run test:unit:client && npm run test:unit:server",
    "test:content": "node --import tsx --test lib/content/ask-text-plugin.test.mjs lib/content/metadata.test.ts lib/content/load.test.ts lib/content/slugs.test.ts lib/content/portfolio/validation.test.ts && node --conditions=react-server --import tsx --test lib/content/discovery.server.test.ts lib/content/github-activity.server.test.ts",
    "test:contrast": "node --import tsx --test tests/contrast.test.ts",
    "test:documentation": "node --import tsx --test tests/documentation.test.ts",
    "test:seo": "node --import tsx --test lib/seo/site-url.test.ts lib/seo/metadata-routes.test.ts",
    "test:plugin-links": "node --conditions=react-server --import tsx --test lib/content/plugin-links.server.test.ts",
    "test:descriptor": "node --import tsx --test \"app/(home)/_components/hero/descriptor-rotation/descriptor-sequence.test.ts\"",
    "test:brand-assets": "node --import tsx --test scripts/generate-brand-assets.test.mjs",
    "setup:browsers": "playwright install chromium webkit",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "test:ask": "node --conditions=react-server --import tsx --test \"app/api/ask/**/*.server.test.{ts,tsx,mjs}\"",
    "test:conversation": "node --import tsx --test \"components/conversation/**/*.test.{ts,tsx,mjs}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@langchain/core": "^1.2.11",
    "@langchain/openai": "^1.5.13",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.1",
    "@shadcn/react": "0.3.1",
    "@thesvg/react": "^3.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "js-yaml": "^4.3.1",
    "langchain": "^1.5.11",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0"
  }
}
